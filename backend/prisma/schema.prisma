generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MASTER
  SALON_OWNER
  SALON_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING_DELETION
  ANONYMIZED
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum MasterWorkStatus {
  AVAILABLE
  SOON_AVAILABLE
  BUSY
  OFFLINE
}

enum BookingStatus {
  pending
  confirmed
  inProgress
  completed
  cancelled
  rejected
  noShow
}

enum FavoriteEntityType {
  SALON
  MASTER
}

enum CatalogSourceType {
  PICKME
  EXTERNAL
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
  partiallyRefunded
  cancelled
}

enum VoucherCodeType {
  PARTNER_MONTH
  PARTNER_YEAR
  PARTNER_DAY
  CLIENT_DISCOUNT
  BOOKING_CREDIT
  PROMO_TRIAL
}

enum VoucherCodeStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum VoucherRedemptionStatus {
  APPLIED
  FAILED
  REVERSED
}

enum PartnerSubscriptionPlan {
  PICKME_PARTNER_MONTHLY
  PICKME_PARTNER_QUARTERLY
  PICKME_PARTNER_SEMIANNUAL
  PICKME_PARTNER_YEARLY
  PICKME_PARTNER_BIENNIAL
  PICKME_PARTNER_TRIAL
}

enum PartnerSubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum PartnerSubscriptionSource {
  VOUCHER
  MANUAL
  PAYMENT
  ACCESS_CODE
}

enum PartnerAccessRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
  CODE_SENT
  ACTIVATED
}

enum PartnerAccessRequestDuration {
  HOUR
  DAY
  MONTH
  THREE_MONTHS
  SIX_MONTHS
  YEAR
  TRIAL
}

enum BookingPaymentProvider {
  STRIPE
  MANUAL_IN_SALON
  DEMO
}

enum BookingPaymentStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BusinessClaimStatus {
  PENDING
  CODE_ISSUED
  ACTIVE_TRIAL
  VERIFICATION_REQUIRED
  APPROVED
  REJECTED
  REVOKED
  TRANSFER_PENDING
}

enum VerificationLevel {
  UNVERIFIED
  SELF_VERIFIED
  CONTACT_VERIFIED
  DOCUMENT_VERIFIED
}

enum BusinessAccessCodeType {
  TRIAL
  STANDARD
  PREMIUM
}

enum BusinessAccessCodeStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum BonusCreditEventType {
  CREDIT_GRANTED
  CREDIT_USED
  CREDIT_EXPIRED
  CREDIT_REVERSED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_STARTS_SOON
  BOOKING_COMPLETED
  NEW_REVIEW
  SCHEDULE_CHANGED
  PRICE_CHANGED
  SALON_MESSAGE
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  phone             String         @unique
  passwordHash      String
  role              Role
  isActive          Boolean        @default(true)
  isVerified        Boolean        @default(false)
  presenceStatus    PresenceStatus @default(OFFLINE)
  provider          AuthProvider   @default(LOCAL)
  providerAccountId String?
  accountStatus     AccountStatus  @default(ACTIVE)
  accountStatusReason String?
  accountStatusUpdatedAt DateTime?
  deletionRequestedAt DateTime?
  anonymizedAt      DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  customerProfile           CustomerProfile?
  masterProfile             MasterProfile?
  salonAdmins               SalonAdmin[]
  refreshTokens             RefreshToken[]
  notifications             Notification[]
  auditLogs                 AuditLog[]        @relation("AuditLogActor")
  auditLogsTarget           AuditLog[]        @relation("AuditLogTarget")
  createdVoucherCodes       VoucherCode[]     @relation("VoucherCreatedBy")
  assignedVoucherCodes      VoucherCode[]     @relation("VoucherAssignedUser")
  voucherRedemptions        VoucherRedemption[]
  partnerSubscriptions      PartnerSubscription[]
  partnerPayments           PartnerPayment[]
  bonusCreditLedgerEntries  BonusCreditLedger[]
  bookingPaymentsAsCustomer BookingPayment[]  @relation("BookingPaymentCustomer")
  partnerAccessRequests     PartnerAccessRequest[]     @relation("PartnerAccessRequestUser")
  assignedPartnerAccessRequests PartnerAccessRequest[] @relation("PartnerAccessRequestAdmin")
  businessClaims            BusinessClaim[]
  businessAccessCodesCreated BusinessAccessCode[] @relation("CreatedBy")
  businessAccessCodesActivated BusinessAccessCode[] @relation("ActivatedBy")
  staffDrafts               SalonStaffDraft[]
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  favorites Favorite[]
  reviews   Review[]
  addresses CustomerAddress[]
}

model MasterProfile {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  salonId                String?
  displayName            String
  sourceType             CatalogSourceType @default(PICKME)
  externalProvider       String?
  externalPlaceId        String?
  specialization         String?
  biography              String?
  experienceYears        Int               @default(0)
  bio                    String?
  isIndependent          Boolean           @default(false)
  acceptsBookings        Boolean           @default(true)
  acceptsUrgentBookings  Boolean           @default(true)
  acceptsHomeVisits      Boolean           @default(false)
  homeVisitRadiusKm      Float             @default(5)
  homeVisitBaseFee       Decimal           @default(0)
  homeVisitPerKmFee      Decimal           @default(0)
  currentStatus          MasterWorkStatus  @default(OFFLINE)
  availableAt            DateTime?
  minutesUntilAvailable  Int?
  publicLatitude         Float?
  publicLongitude        Float?
  avatarUrl              String?
  isVerified             Boolean           @default(false)
  ratingAverage          Float             @default(0)
  reviewCount            Int               @default(0)
  completedBookingsCount Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon           Salon?                @relation(fields: [salonId], references: [id], onDelete: SetNull)
  salonLinks      SalonMaster[]
  services        MasterService[]
  schedules       WorkingSchedule[]
  bookings        Booking[]
  portfolioItems  MasterPortfolioItem[]
  homeVisitQuotes HomeVisitQuote[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([salonId])
  @@index([isVerified])
  @@index([isIndependent])
}

model Salon {
  id                     String            @id @default(cuid())
  slug                   String            @unique
  name                   String
  description            String?
  phone                  String?
  email                  String?
  website                String?
  addressLine            String
  addressLine1           String?
  city                   String
  country                String
  countryCode            String            @default("DE")
  postalCode             String
  latitude               Float?
  longitude              Float?
  ratingAverage          Float             @default(0)
  ratingCount            Int               @default(0)
  openingStatus          String            @default("ACTIVE")
  sourceType             CatalogSourceType @default(PICKME)
  externalProvider       String?
  externalPlaceId        String?
  isVerified             Boolean           @default(false)
  homeVisitEnabled       Boolean           @default(false)
  isActive               Boolean           @default(true)
  openingHoursJson       Json?
  cancellationPolicyJson Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  admins               SalonAdmin[]
  masters              SalonMaster[]
  masterProfiles       MasterProfile[]
  services             Service[]
  bookings             Booking[]
  photos               SalonPhoto[]
  reviews              Review[]
  favorites            Favorite[]
  voucherCodes         VoucherCode[]
  voucherRedemptions   VoucherRedemption[]
  partnerSubscriptions PartnerSubscription[]
  partnerPayments      PartnerPayment[]
  bookingPayments      BookingPayment[]      @relation("BookingPaymentPartner")
  businessClaims       BusinessClaim[]
  businessAccessCodes  BusinessAccessCode[]
  staffDrafts          SalonStaffDraft[]

  @@index([name])
  @@index([city])
  @@index([postalCode])
  @@index([latitude, longitude])
  @@index([isVerified])
}

model SalonAdmin {
  id        String   @id @default(cuid())
  userId    String
  salonId   String
  role      String?  @default("OWNER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([userId, salonId])
  @@index([salonId])
}

model SalonMaster {
  id                  String   @id @default(cuid())
  salonId             String
  masterId            String
  role                String?  @default("TEAM_MEMBER")
  isActive            Boolean  @default(true)
  acceptsHomeVisits   Boolean  @default(false)
  temporarilyDisabled Boolean  @default(false)
  startedAt           DateTime @default(now())
  createdAt           DateTime @default(now())

  salon  Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([salonId, masterId])
  @@index([masterId])
  @@index([salonId, isActive])
}

model Service {
  id               String   @id @default(cuid())
  salonId          String?
  slug             String   @default(cuid())
  name             String
  description      String?
  category         String
  basePrice        Decimal
  price            Decimal?
  currency         String   @default("EUR")
  durationMinutes  Int
  availableInSalon Boolean  @default(true)
  availableAtHome  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salon    Salon?          @relation(fields: [salonId], references: [id], onDelete: SetNull)
  masters  MasterService[]
  bookings Booking[]

  @@index([salonId])
  @@index([category])
  @@index([isActive])
}

model MasterService {
  id                      String   @id @default(cuid())
  masterId                String
  serviceId               String
  priceOverride           Decimal?
  durationMinutesOverride Int?
  isActive                Boolean  @default(true)
  availableInSalon        Boolean  @default(true)
  availableAtHome         Boolean  @default(false)
  createdAt               DateTime @default(now())

  master  MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([masterId, serviceId])
  @@index([serviceId])
  @@index([isActive])
}

model WorkingSchedule {
  id                     String   @id @default(cuid())
  masterId               String
  salonId                String?
  dayOfWeek              Int
  shiftStart             String
  shiftEnd               String
  isDayOff               Boolean  @default(false)
  acceptsBookings        Boolean  @default(true)
  acceptsUrgentBookings  Boolean  @default(true)
  supportsHomeVisits     Boolean  @default(false)
  bookingBufferMinutes   Int      @default(5)
  homeVisitBufferMinutes Int      @default(15)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  master MasterProfile   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  breaks ScheduleBreak[]

  @@index([masterId, dayOfWeek])
  @@index([salonId])
}

model ScheduleBreak {
  id         String  @id @default(cuid())
  scheduleId String
  startTime  String
  endTime    String
  reason     String?

  schedule WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model Booking {
  id                         String        @id @default(cuid())
  customerProfileId          String
  masterId                   String
  salonId                    String?
  serviceId                  String
  status                     BookingStatus @default(pending)
  startsAt                   DateTime
  endsAt                     DateTime
  totalPrice                 Decimal
  currency                   String        @default("EUR")
  isHomeVisit                Boolean       @default(false)
  cancellationPolicySnapshot Json?
  commissionSnapshot         Json?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  customer                 CustomerProfile        @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  master                   MasterProfile          @relation(fields: [masterId], references: [id], onDelete: Cascade)
  salon                    Salon?                 @relation(fields: [salonId], references: [id], onDelete: SetNull)
  service                  Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  extras                   BookingExtra[]
  statusHistory            BookingStatusHistory[]
  homeVisitDetails         HomeVisitDetails?
  review                   Review?
  payments                 Payment[]
  voucherRedemptions       VoucherRedemption[]
  bonusCreditLedgerEntries BonusCreditLedger[]
  bookingPayments          BookingPayment[]

  @@index([masterId, startsAt, endsAt])
  @@index([customerProfileId, startsAt])
}

model BookingExtra {
  id              String  @id @default(cuid())
  bookingId       String
  name            String
  price           Decimal
  durationMinutes Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingStatusHistory {
  id         String         @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  changedBy  String
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model HomeVisitDetails {
  id                   String   @id @default(cuid())
  bookingId            String   @unique
  quoteId              String
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float
  distanceKm           Float
  travelMinutes        Int
  arrivalWindowStart   DateTime
  arrivalWindowEnd     DateTime
  createdAt            DateTime @default(now())

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quote   HomeVisitQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
}

model HomeVisitQuote {
  id                     String   @id @default(cuid())
  masterId               String
  serviceId              String
  destinationAddress     String
  destinationLatitude    Float
  destinationLongitude   Float
  distanceKm             Float
  travelMinutes          Int
  serviceDurationMinutes Int
  arrivalWindowStart     DateTime
  arrivalWindowEnd       DateTime
  priceBreakdownJson     Json
  tariffVersion          String
  expiresAt              DateTime
  createdAt              DateTime @default(now())

  master           MasterProfile      @relation(fields: [masterId], references: [id], onDelete: Cascade)
  homeVisitDetails HomeVisitDetails[]

  @@index([masterId, expiresAt])
}

model Review {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  customerProfileId String
  masterId          String
  salonId           String?
  rating            Int
  text              String?
  createdAt         DateTime @default(now())

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  master   MasterProfile   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  salon    Salon?          @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([masterId])
  @@index([salonId])
  @@index([rating])
}

model Favorite {
  id                String             @id @default(cuid())
  customerProfileId String
  entityType        FavoriteEntityType
  salonId           String?
  masterId          String?
  createdAt         DateTime           @default(now())

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  salon    Salon?          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  master   MasterProfile?  @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, entityType, salonId, masterId])
  @@index([customerProfileId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  payload   Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  familyId          String
  parentTokenId     String?
  replacedByTokenId String?
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model CustomerAddress {
  id                String   @id @default(cuid())
  customerProfileId String
  label             String
  addressLine1      String
  city              String
  country           String
  postalCode        String
  latitude          Float
  longitude         Float
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
}

model MasterPortfolioItem {
  id              String   @id @default(cuid())
  masterId        String
  imageUrl        String
  title           String?
  description     String?
  serviceCategory String?
  caption         String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId])
}

model SalonPhoto {
  id        String   @id @default(cuid())
  salonId   String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model Payment {
  id                       String        @id @default(cuid())
  bookingId                String
  externalPaymentIntentId  String?
  status                   PaymentStatus @default(pending)
  amount                   Decimal
  currency                 String        @default("EUR")
  platformCommissionAmount Decimal       @default(0)
  paidAt                   DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  booking     Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds     Refund[]
  commissions PlatformCommission[]

  @@index([bookingId])
}

model VoucherCode {
  id              String            @id @default(cuid())
  codeHash        String
  codePrefix      String
  type            VoucherCodeType
  valueAmount     Decimal?
  valuePercent    Float?
  currency        String?           @default("EUR")
  durationDays    Int?
  maxRedemptions  Int               @default(1)
  redemptionCount Int               @default(0)
  validFrom       DateTime?
  expiresAt       DateTime?
  status          VoucherCodeStatus @default(ACTIVE)
  assignedUserId  String?
  assignedSalonId String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  revokedAt       DateTime?
  metadata        Json?

  assignedUser             User?               @relation("VoucherAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedSalon            Salon?              @relation(fields: [assignedSalonId], references: [id], onDelete: SetNull)
  createdByUser            User                @relation("VoucherCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  redemptions              VoucherRedemption[]
  bonusCreditLedgerEntries BonusCreditLedger[]

  @@index([codePrefix])
  @@index([type])
  @@index([status])
  @@index([assignedUserId])
  @@index([assignedSalonId])
  @@index([createdByUserId])
}

model VoucherRedemption {
  id             String                  @id @default(cuid())
  voucherCodeId  String
  userId         String
  salonId        String?
  bookingId      String?
  status         VoucherRedemptionStatus @default(APPLIED)
  amountApplied  Decimal?
  percentApplied Float?
  currency       String?                 @default("EUR")
  details        Json?
  createdAt      DateTime                @default(now())

  voucherCode          VoucherCode           @relation(fields: [voucherCodeId], references: [id], onDelete: Restrict)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon                Salon?                @relation(fields: [salonId], references: [id], onDelete: SetNull)
  booking              Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  partnerSubscriptions PartnerSubscription[]
  bookingPayments      BookingPayment[]

  @@unique([voucherCodeId, userId, bookingId])
  @@index([voucherCodeId])
  @@index([userId])
  @@index([salonId])
  @@index([bookingId])
}

model PartnerSubscription {
  id                  String                    @id @default(cuid())
  userId              String
  salonId             String
  plan                PartnerSubscriptionPlan
  status              PartnerSubscriptionStatus @default(ACTIVE)
  source              PartnerSubscriptionSource
  startsAt            DateTime
  endsAt              DateTime
  voucherRedemptionId String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon             Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  voucherRedemption VoucherRedemption? @relation(fields: [voucherRedemptionId], references: [id], onDelete: SetNull)

  @@index([userId, salonId])
  @@index([status, endsAt])
}

model PartnerPayment {
  id                  String   @id @default(cuid())
  userId              String
  salonId             String
  planId              String   // e.g. "PICKME_PARTNER_QUARTERLY"
  durationMonths      Int
  amount              Decimal
  currency            String   @default("EUR")
  status              String   @default("CREATED") // CREATED | PENDING | TEST_SUCCEEDED | SUCCEEDED | FAILED | CANCELLED
  isTest              Boolean  @default(false)
  providerReference   String?
  confirmedAt         DateTime?
  subscriptionId      String?  // linked PartnerSubscription if extended
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([userId, salonId])
  @@index([status])
  @@index([salonId])
}

model BonusCreditLedger {
  id            String               @id @default(cuid())
  userId        String
  eventType     BonusCreditEventType
  amount        Decimal
  currency      String               @default("EUR")
  expiresAt     DateTime?
  voucherCodeId String?
  bookingId     String?
  note          String?
  metadata      Json?
  createdAt     DateTime             @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherCode VoucherCode? @relation(fields: [voucherCodeId], references: [id], onDelete: SetNull)
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BookingPayment {
  id                      String                 @id @default(cuid())
  bookingId               String
  customerId              String
  partnerId               String
  provider                BookingPaymentProvider
  providerPaymentIntentId String?
  subtotal                Decimal
  discount                Decimal                @default(0)
  travelFee               Decimal                @default(0)
  platformFee             Decimal                @default(0)
  total                   Decimal
  currency                String                 @default("EUR")
  status                  BookingPaymentStatus   @default(PENDING)
  voucherRedemptionId     String?
  createdAt               DateTime               @default(now())
  paidAt                  DateTime?
  refundedAt              DateTime?

  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer          User               @relation("BookingPaymentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  partner           Salon              @relation("BookingPaymentPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  voucherRedemption VoucherRedemption? @relation(fields: [voucherRedemptionId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([customerId])
  @@index([partnerId])
  @@index([providerPaymentIntentId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  amount           Decimal
  reason           String?
  externalRefundId String?
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PlatformCommission {
  id             String   @id @default(cuid())
  paymentId      String
  bookingId      String
  percentageRate Decimal?
  fixedFee       Decimal?
  homeVisitFee   Decimal?
  totalAmount    Decimal
  snapshotJson   Json
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PartnerAccessRequest {
  id                String   @id @default(cuid())
  contactName       String
  salonName         String
  city              String
  phone             String
  email             String
  message           String?
  requestedDuration PartnerAccessRequestDuration
  googlePlaceId     String?
  status            PartnerAccessRequestStatus @default(PENDING)
  assignedAdminId   String?
  userId            String?
  contactedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  codeSentAt        DateTime?
  activatedAt       DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User? @relation("PartnerAccessRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin User? @relation("PartnerAccessRequestAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([assignedAdminId])
}

model BusinessClaim {
  id                  String              @id @default(cuid())
  userId              String
  salonId             String?
  googlePlaceId       String?
  status              BusinessClaimStatus @default(PENDING)
  verificationLevel   VerificationLevel   @default(UNVERIFIED)
  startedAt           DateTime            @default(now())
  activatedAt         DateTime?
  revokedAt           DateTime?
  revokeReason        String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon  Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([salonId])
  @@index([googlePlaceId])
  @@index([status])
  @@unique([userId, salonId]) // One claim per user per salon
}

model BusinessAccessCode {
  id                      String                      @id @default(cuid())
  codeHash                String                      @unique // Hash of actual code
  codePrefix              String                      // First 8 chars of code for display
  targetSalonId           String?
  targetGooglePlaceId     String?
  assignedEmail           String?
  durationDays            Int                         @default(30)
  type                    BusinessAccessCodeType      @default(STANDARD)
  status                  BusinessAccessCodeStatus    @default(ACTIVE)
  maxRedemptions          Int                         @default(1)
  redemptionCount         Int                         @default(0)
  expiresAt               DateTime                    // Code activation deadline
  createdByUserId         String
  activatedByUserId       String?
  activatedAt             DateTime?
  revokedAt               DateTime?
  revokeReason            String?
  metadata                Json?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  createdBy   User  @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedBy User? @relation("ActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  targetSalon Salon? @relation(fields: [targetSalonId], references: [id], onDelete: SetNull)

  @@index([targetSalonId])
  @@index([targetGooglePlaceId])
  @@index([assignedEmail])
  @@index([status])
  @@index([type])
  @@index([expiresAt])
  @@index([createdByUserId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  targetUserId String?
  action     String
  entityType String
  entityId   String?
  requestId  String?
  before     Json?
  after      Json?
  reason     String?
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actorUser  User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([entityType, entityId])
}

enum StaffDraftStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SalonStaffDraft {
  id              String           @id @default(cuid())
  salonId         String
  createdByUserId String
  displayName     String
  specialization  String?
  status          StaffDraftStatus @default(DRAFT)
  workStatus      MasterWorkStatus @default(AVAILABLE)
  avatarUrl       String?
  metadata        Json?
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  salon       Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdBy   User  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([createdByUserId])
  @@index([status])
}
